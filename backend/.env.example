# Variáveis da stack `jcproducao` no Portainer (ou .env desta pasta, num compose manual).
# NUNCA versionar o .env preenchido. Gerar segredos com: openssl rand -hex 24

# domínio do backend (registro A no DNS da Totali → IP da VPS)
API_DOMAIN=api.jcproducao.totalicontabilidade.com.br
TZ=America/Sao_Paulo

# Postgres da Evolution API (só rede interna)
POSTGRES_PASSWORD=

# Evolution API — chave global (AUTHENTICATION_API_KEY) e nome da instância do número
WA_API_KEY=
WA_INSTANCIA=jc_principal
# Bearer que a Evolution manda ao chamar o webhook do backend
WA_WEBHOOK_TOKEN=
# chave da página https://<API_DOMAIN>/wa/qr?chave=... (parear o celular)
WA_ADMIN_CHAVE=

# Firebase Admin — JSON da conta de serviço do projeto producaojcsacolas, em base64:
#   base64 -i conta-de-servico.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=

# segredo das URLs assinadas das mídias
MIDIA_SEGREDO=
