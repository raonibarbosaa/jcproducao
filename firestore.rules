rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meu() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function temPerfil() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function ehStaff() {
      return temPerfil() && meu().perfil in ['dono', 'designer', 'financeiro'];
    }
    function ehVendedor() {
      return temPerfil() && meu().perfil == 'vendedor';
    }
    function ehOperador() {
      return temPerfil() && meu().perfil == 'operador';
    }
    function ehExpedicao() {
      return temPerfil() && meu().perfil == 'expedicao';
    }
    function meuVendedor() { return meu().vendedorNome; }
    // operador com Expedição/Entrega liberada trabalha com carga: a permissão é
    // de DOIS eixos (perfil × setores), então o setor também tem que valer aqui,
    // senão a tela aparece para ele e nada funciona.
    function trabalhaComCarga() {
      return ehStaff() || ehExpedicao()
        || (ehOperador() && meu().get('setores', []).hasAny(['expedicao', 'entrega']));
    }

    // Perfis: cada um lê o próprio doc (para descobrir seu perfil); staff gerencia todos.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehStaff());
      allow write: if ehStaff();
    }

    // Pedidos: staff vê tudo; operador vê tudo (precisa do quadro); vendedor só os
    // pedidos do SEU vendedor (consulta filtrada).
    match /pedidos/{id} {
      allow read: if ehStaff() || ehOperador() || ehExpedicao()
        || (ehVendedor() && resource.data.vendedor == meuVendedor());
      allow create, delete: if ehStaff();
      // staff atualiza qualquer campo; operador/expedição só mexem nas ETAPAS.
      // A etapa agora é POR ITEM (mapa `etapas`), então a regra não tem como conferir
      // item a item de qual setor cada um saiu — isso é conferido na tela
      // (podeMoverEtapa no QuadroProducao). Aqui garantimos duas coisas: que nenhum
      // outro campo é tocado e que o operador tem pelo menos um setor liberado.
      allow update: if ehStaff()
        || (ehOperador()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['etapas', 'etapa', 'etapaPor', 'etapaEm'])
            && meu().get('setores', []).size() > 0)
        // operador de Expedição/Entrega marca a saída da carga, como a expedição
        || (ehOperador()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['etapas', 'etapa', 'etapaPor', 'etapaEm',
                           'saidaEm', 'saidaMotorista', 'saidaPor'])
            && meu().get('setores', []).hasAny(['expedicao', 'entrega']))
        // Expedição: além das etapas, marca a SAÍDA da rota (é quem carrega o
        // caminhão e sabe a hora que ele saiu). Continua sem poder dar a entrega,
        // que é o que move o pedido para `entregues`.
        || (ehExpedicao()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['etapas', 'etapa', 'etapaPor', 'etapaEm',
                           'saidaEm', 'saidaMotorista', 'saidaPor']));
    }

    // Entregues: staff escreve e lê tudo. O VENDEDOR lê só as entregas dos
    // próprios pedidos — o doc guarda o pedido inteiro, inclusive `vendedor`
    // (Rota.jsx grava com spread), então a regra vale também para os registros
    // antigos. A consulta da tela precisa vir com where('vendedor','==',...),
    // senão o Firestore recusa. Atenção: regra libera o DOCUMENTO inteiro, não
    // campo a campo — o vendedor enxerga também a baixa financeira (pago/pagoEm)
    // dos pedidos dele. Foi decisão deliberada.
    match /entregues/{id} {
      allow read: if ehStaff()
        || (ehVendedor() && resource.data.vendedor == meuVendedor());
      allow write: if ehStaff();
    }

    // Cadastros (config/cadastros): quem TEM PERFIL lê (o app precisa para
    // resolver nomes/rotas); apenas staff altera.
    //
    // ⚠️ Era `logado()` e isso era um vazamento: o cadastro público do Firebase
    // está aberto e o repositório é público, então qualquer pessoa criava uma
    // conta e lia este documento — que guarda a CARTEIRA DE CLIENTES, a TABELA
    // DE PREÇOS, as rotas de cada vendedor e o telefone dos motoristas.
    // `temPerfil()` fecha porque a conta recém-criada não tem doc em `usuarios`.
    match /config/{doc} {
      allow read: if temPerfil();
      allow write: if ehStaff();
    }

    // Ciência: staff LÊ todas; quem CRIA é só o vendedor, e só em nome dele.
    // ⚠️ Dono e designer não dão ciência (decisão do dono em 17/08/2026) — a
    // ciência é a assinatura de quem vendeu, e assinada por outro não prova
    // nada. Tirar o botão da tela sem fechar aqui seria esconder o caminho, não
    // trancá-lo. Também exige que a assinatura seja do próprio usuário logado:
    // sem isso dava para gravar ciência em nome de outra pessoa.
    match /ciencias/{id} {
      allow read: if ehStaff()
        || (ehVendedor() && resource.data.vendedor == meuVendedor());
      allow create: if ehVendedor()
        && request.resource.data.vendedor == meuVendedor()
        && request.resource.data.porUid == request.auth.uid;
      // registro de assinatura não se edita: corrigível, não provaria nada
      allow update: if false;
      allow delete: if ehStaff();
    }

    // Cargas: a viagem do caminhão, montada pela EXPEDIÇÃO. Ela cria, confere e
    // marca a saída — mas continua sem dar a entrega, que é o que abre a cobrança
    // (isso segue em `entregues`, só para staff).
    match /cargas/{id} {
      allow read: if ehStaff() || ehExpedicao() || ehOperador();
      allow create, update: if trabalhaComCarga();
      allow delete: if ehStaff();
    }

    // Planos de entrega: a PREVISÃO da viagem, montada antes de a mercadoria
    // existir. Guarda números de pedido (a carga é que guarda volume). Mesma
    // regra da carga — quem monta a viagem é quem planeja.
    match /planos/{id} {
      allow read: if ehStaff() || ehExpedicao() || ehOperador();
      allow create, update, delete: if trabalhaComCarga();
    }

    // Problemas: erro reportado por quem está produzindo (o papel diz uma coisa,
    // o sistema outra). QUALQUER pessoa com perfil reporta — quem vê o erro é
    // quem está com a peça na mão. Só staff resolve/fecha.
    match /problemas/{id} {
      // o vendedor só enxerga os erros dos PRÓPRIOS pedidos — mesma regra do
      // resto do sistema; sem isso ele veria cliente e número de pedido alheio
      allow read: if ehStaff() || ehOperador() || ehExpedicao()
        || (ehVendedor() && resource.data.vendedor == meuVendedor());
      allow create: if temPerfil();
      allow update, delete: if ehStaff();
    }

    // Auditoria: log APPEND-ONLY de quem moveu cada item no quadro.
    // Escreve quem pode mover (staff, operador, expedição) — o registro vai no
    // mesmo writeBatch da mudança de etapa. Lê SÓ o dono. Ninguém edita nem
    // apaga, nem o dono: um log que pode ser corrigido não prova nada.
    match /auditoria/{id} {
      allow read: if temPerfil() && meu().perfil == 'dono';
      // ⚠️ `porUid` TEM que ser quem está assinando: sem isso dava para gravar
      // um movimento em nome de outra pessoa, e um log que aceita assinatura
      // falsa não serve de prova.
      allow create: if (ehStaff() || ehOperador() || ehExpedicao())
        && request.resource.data.porUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
